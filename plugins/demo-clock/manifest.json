{
  "schemaVersion": 1,
  "id": "demo-clock",
  "name": "演示时钟",
  "version": "0.1.0",
  "description": "审核流程演示用：起一个显示当前时间的 HTTP 小页，无副作用。",
  "publisher": "amwu126",
  "category": "演示",
  "architectures": ["arm64", "x86_64"],
  "permissions": ["NETWORK"],
  "launchType": "service",
  "servicePort": 18082,
  "servicePath": "/",
  "installSteps": ["mkdir -p $JY_PLUGIN_DIR/payload"],
  "launchCommand": "cd $JY_PLUGIN_DIR/payload && busybox httpd -f -p 18082",
  "verifyCommand": "test -f $JY_PLUGIN_DIR/payload/index.html"
}
